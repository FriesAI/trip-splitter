# Copy to .env and fill in. Never commit .env — see .gitignore.
# A variable left at its placeholder value is treated as "not configured":
# the app falls back to manual entry rather than failing.

# --- Supabase (database, auth, realtime, private file storage) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only. Never expose to the browser, never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Google Cloud Vision (receipt OCR, OCR-01..04) ---
# Called from a server function only, so the key never reaches a phone.
GOOGLE_VISION_API_KEY=your-vision-api-key-here

# --- FX rates (Frankfurter / ECB) ---
# Free and keyless; override only to point at a mirror or a paid source.
FX_API_BASE=https://api.frankfurter.app
